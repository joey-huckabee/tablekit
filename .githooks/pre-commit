#!/bin/sh
#
# Refuses commits on main and CRLF in staged text.
#
# main is treated as protected in this repository (AGENTS.md). This local check complements
# any protections configured on the hosting service.
#
# Install once per clone:  git config core.hooksPath .githooks
# Bypass deliberately:     git commit --no-verify

set -e

RED=''; BOLD=''; OFF=''
if [ -t 2 ]; then
  RED=$(printf '\033[31m'); BOLD=$(printf '\033[1m'); OFF=$(printf '\033[0m')
fi

# A detached HEAD returns nothing and is left alone - rebases and bisects run hooks too.
branch=$(git symbolic-ref --short -q HEAD || true)

if [ "$branch" = "main" ]; then
  printf '%s\n' "${RED}${BOLD}pre-commit: refusing to commit on main.${OFF}" >&2
  printf '%s\n' "" \
    "  main is treated as protected in this repository (AGENTS.md). Branch" \
    "  protection is not available on this plan, so this hook is the only thing" \
    "  enforcing it. Land the work through a pull request instead:" \
    "" \
    "      git switch -c <type>/<short-name>" \
    "      git commit ..." \
    "      gh pr create" \
    "" \
    "  Deliberate? Commit again with --no-verify." >&2
  exit 1
fi

# Prefer python: the Windows python3 alias may exist but fail to launch.
if command -v python >/dev/null 2>&1; then
  python .githooks/check_line_endings.py
elif command -v python3 >/dev/null 2>&1; then
  python3 .githooks/check_line_endings.py
else
  printf '%s\n' 'pre-commit: Python 3 is required for the staged LF check (python or python3).' >&2
  exit 1
fi

exit 0
